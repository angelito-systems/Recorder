<Window x:Class="Angelito.ScreenStudio.Desktop.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Angelito Screen Studio Pro — Grabador" Width="420" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <DockPanel>
            <Button Content="Acerca de" DockPanel.Dock="Right" Click="OnAbout" Padding="10,2" VerticalAlignment="Center" ToolTip="Versión y diagnóstico"/>
            <TextBlock Text="Nueva grabación" FontSize="20" FontWeight="SemiBold"/>
        </DockPanel>
        <TextBlock x:Name="Status" Style="{StaticResource Hint}" Text="Detectando pantallas y codificadores…" Margin="0,4,0,0"/>

        <TextBlock Style="{StaticResource Section}" Text="Pantalla"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="MonitorBox" ToolTip="Monitor a grabar"/>
            <ComboBox x:Name="FpsBox" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="2" ToolTip="Fotogramas por segundo">
                <ComboBoxItem Content="24 FPS" Tag="24"/>
                <ComboBoxItem Content="30 FPS" Tag="30"/>
                <ComboBoxItem Content="60 FPS" Tag="60"/>
            </ComboBox>
        </Grid>

        <ComboBox x:Name="WindowBox" Margin="0,8,0,0" DropDownOpened="OnWindowListOpen" SelectionChanged="OnWindowPick"
                  ToolTip="Graba solo esa ventana, aunque otras la tapen"/>
        <DockPanel x:Name="AreaRow" Margin="0,8,0,0">
            <Button x:Name="RegionBtn" DockPanel.Dock="Right" Content="Seleccionar región…" Click="OnRegion"/>
            <Button x:Name="FullBtn" DockPanel.Dock="Right" Content="Completa" Click="OnFullScreen" Margin="0,0,6,0" Visibility="Collapsed"/>
            <TextBlock x:Name="AreaText" VerticalAlignment="Center" Text="Pantalla completa"/>
        </DockPanel>

        <TextBlock Style="{StaticResource Section}" Text="Cámara"/>
        <ComboBox x:Name="CamBox" ToolTip="Se graba como pista separada, editable después"/>

        <TextBlock Style="{StaticResource Section}" Text="Audio"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <CheckBox x:Name="MicBox" Content="Micrófono" IsChecked="True"/>
            <ProgressBar x:Name="MicMeter" Grid.Column="1" Height="6" Maximum="1" VerticalAlignment="Center"/>
            <CheckBox x:Name="SysBox" Grid.Row="1" Content="Audio del sistema" IsChecked="True" Margin="0,6,0,0"/>
            <ProgressBar x:Name="SysMeter" Grid.Row="1" Grid.Column="1" Height="6" Maximum="1" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Text="Se registran la posición y los clics del ratón para editar zoom y efectos después."/>
        <CheckBox x:Name="KeysBox" Content="Mostrar atajos de teclado" Margin="0,10,0,0"/>
        <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                   Text="Solo se guardan combinaciones de una lista permitida (Ctrl+S, Alt+Tab…). Nunca texto escrito ni contraseñas; se ignoran los gestores de contraseñas. Ctrl+Mayús+F12 suspende o reanuda al instante."/>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PauseBtn" Grid.Column="1" Margin="8,0,0,0" Padding="14,0" Content="❚❚ Pausar" Click="OnPause" Visibility="Collapsed"
                    ToolTip="Mientras está en pausa no se captura pantalla, cámara, cursor ni audio"/>
            <Button x:Name="RecordBtn" Height="44" FontSize="15" Click="OnRecord" IsEnabled="False"
                    Background="{StaticResource Rec}" Foreground="White" Content="● Grabar"/>
            <Button x:Name="OpenBtn" Grid.Column="2" Margin="8,0,0,0" Padding="12,0" Content="Abrir proyecto…" Click="OnOpen"/>
        </Grid>
        <TextBlock x:Name="Timer" HorizontalAlignment="Center" FontSize="28" FontFamily="Cascadia Mono, Consolas"
                   Margin="0,12,0,0" Visibility="Collapsed" Text="00:00:00"/>
        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,6,0,0"
                   Text="Esta ventana no aparece en la grabación."/>
    </StackPanel>
</Window>
