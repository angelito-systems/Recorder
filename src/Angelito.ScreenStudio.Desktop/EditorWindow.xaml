<Window x:Class="Angelito.ScreenStudio.Desktop.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Angelito Screen Studio Pro — Editor" Width="1360" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" PreviewKeyDown="OnKey">
    <Window.Resources>
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Left rail: one icon per tool; the checked one fills the settings panel. -->
        <Style x:Key="RailButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Rail"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#337C5CFA"/>
                                <Setter Property="Foreground" Value="{StaticResource Brand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="260" MinHeight="180"/>
        </Grid.RowDefinitions>

        <!-- Top bar: project on the left, export on the right -->
        <DockPanel Margin="12,8,12,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Image Source="Assets/app-256.png" Width="22" Height="22" Margin="2,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="ProjectName" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Click="OnOpen" ToolTip="Abrir proyecto (Ctrl+O)" AutomationProperties.Name="Abrir proyecto"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Click="OnSave" ToolTip="Guardar (Ctrl+S) — también se guarda automáticamente" AutomationProperties.Name="Guardar"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE81C;" Click="OnVersions" ToolTip="Versiones anteriores guardadas automáticamente" AutomationProperties.Name="Versiones"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <ComboBox x:Name="ModeBox" Width="130" Margin="0,0,8,0" SelectionChanged="OnModeChanged" ToolTip="Simple: grabar, recortar, zoom y exportar. Avanzado: todas las herramientas. Cambiar de modo no modifica el proyecto.">
                    <ComboBoxItem Content="Modo simple"/>
                    <ComboBoxItem Content="Modo avanzado"/>
                </ComboBox>
                <Button Style="{StaticResource IconButton}" Content="&#xE946;" Click="OnAbout" ToolTip="Acerca de y diagnóstico" AutomationProperties.Name="Acerca de"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" Click="OnShowQueue" ToolTip="Cola de exportaciones" AutomationProperties.Name="Cola de exportaciones"/>
                <Button x:Name="ExportBtn" Style="{StaticResource AccentButton}" Click="OnExport" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE898;" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Exportar"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="300" MinWidth="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tool rail -->
            <StackPanel Margin="8,0,8,0">
                <RadioButton x:Name="RailZoom" Style="{StaticResource RailButton}" Tag="PageZoom" Checked="OnRail" ToolTip="Zoom" AutomationProperties.Name="Zoom">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE71E;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailCursor" Style="{StaticResource RailButton}" Tag="PageCursor" Checked="OnRail" ToolTip="Cursor y clics" AutomationProperties.Name="Cursor y clics">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7C9;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailCamera" Style="{StaticResource RailButton}" Tag="PageCamera" Checked="OnRail" ToolTip="Cámara" AutomationProperties.Name="Cámara">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE714;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailAudio" Style="{StaticResource RailButton}" Tag="PageAudio" Checked="OnRail" ToolTip="Audio" AutomationProperties.Name="Audio">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE767;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailText" Style="{StaticResource RailButton}" Tag="PageText" Checked="OnRail" ToolTip="Texto" AutomationProperties.Name="Texto">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D2;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailSubs" Style="{StaticResource RailButton}" Tag="PageSubs" Checked="OnRail" ToolTip="Subtítulos" AutomationProperties.Name="Subtítulos">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7F0;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailAnn" Style="{StaticResource RailButton}" Tag="PageAnn" Checked="OnRail" ToolTip="Anotaciones" AutomationProperties.Name="Anotaciones">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70F;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailKeys" Style="{StaticResource RailButton}" Tag="PageKeys" Checked="OnRail" ToolTip="Atajos de teclado" AutomationProperties.Name="Atajos de teclado">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE765;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailFormat" Style="{StaticResource RailButton}" Tag="PageFormat" Checked="OnRail" ToolTip="Formato y encuadre" AutomationProperties.Name="Formato y encuadre">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE799;" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="RailExport" Style="{StaticResource RailButton}" Tag="PageExport" Checked="OnRail" ToolTip="Exportación" AutomationProperties.Name="Exportación">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE898;" FontSize="18"/>
                </RadioButton>
            </StackPanel>

            <!-- Settings panel: only the page of the selected tool -->
            <Border Grid.Column="1" Margin="0,0,12,0" CornerRadius="10" Padding="14,12,6,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock x:Name="PageTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="SimpleNote" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,8,8" Visibility="Collapsed"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <Grid>
                    <StackPanel x:Name="PageZoom" Visibility="Collapsed" Tag="Zoom">
                                        <WrapPanel>
                        <Button Content="Regenerar" Click="OnAutoZoom" ToolTip="Vuelve a calcular los zooms automáticos con los ajustes de abajo; los zooms añadidos a mano se conservan"/>
                        <Button Content="Añadir" Click="OnAddZoom" Margin="6,0,0,0" ToolTip="Nuevo zoom de 3 s en el cabezal"/>
                        <Button x:Name="DelZoomBtn" Content="Quitar" Click="OnDeleteZoom" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <StackPanel x:Name="ZoomPanel" Margin="0,8,0,0">
                        <TextBlock x:Name="ZoomInfo" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Intensidad" Margin="0,6,0,0"/>
                        <Slider x:Name="ZoomScale" Minimum="1" Maximum="4" ValueChanged="OnZoomEdit" ToolTip="1.0× = solo mover el encuadre"/>
                        <TextBlock Text="Duración de la animación (entrada y salida)"/>
                        <Slider x:Name="ZoomRamp" Minimum="0.1" Maximum="2" ValueChanged="OnZoomEdit"/>
                        <WrapPanel>
                            <Button Content="Inicio = cabezal" Click="OnZoomStartHere"/>
                            <Button Content="Fin = cabezal" Click="OnZoomEndHere" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Haz clic en la vista previa para centrar el zoom seleccionado."/>
                    </StackPanel>
                    <Expander Header="Zoom automático" Margin="0,10,0,0" IsExpanded="True">
                        <StackPanel Margin="0,6,0,0">
                            <CheckBox x:Name="AzEnabled" Content="Zoom al hacer clic" Click="OnAutoZoomSetting" ToolTip="Acercar al hacer clic y volver al 100 % tras la inactividad"/>
                            <CheckBox x:Name="AzFollow" Content="Seguir al cursor entre regiones" Click="OnAutoZoomSetting" Margin="0,4,0,0"
                                      ToolTip="Un clic fuera de la zona ampliada desplaza el encuadre en lugar de alejar y volver a acercar"/>
                            <TextBlock x:Name="AzScaleText" Margin="0,8,0,0"/>
                            <Slider x:Name="AzScale" Minimum="1.1" Maximum="3" SmallChange="0.1" LargeChange="0.25" ValueChanged="OnAutoZoomSlider"/>
                            <TextBlock x:Name="AzIdleText"/>
                            <Slider x:Name="AzIdle" Minimum="0.5" Maximum="6" SmallChange="0.1" LargeChange="0.5" ValueChanged="OnAutoZoomSlider"
                                    ToolTip="Tiempo sin clics antes de volver al 100 %"/>
                            <TextBlock x:Name="AzHoldText"/>
                            <Slider x:Name="AzHold" Minimum="0.3" Maximum="4" SmallChange="0.1" LargeChange="0.5" ValueChanged="OnAutoZoomSlider"
                                    ToolTip="Tiempo mínimo con el zoom completo, aunque no haya más clics"/>
                            <TextBlock x:Name="AzInText"/>
                            <Slider x:Name="AzIn" Minimum="0.15" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnAutoZoomSlider"/>
                            <TextBlock x:Name="AzOutText"/>
                            <Slider x:Name="AzOut" Minimum="0.15" Maximum="2" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnAutoZoomSlider"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Curva: suave al entrar y al salir. Los cambios se aplican al momento a los zooms automáticos; los añadidos a mano no se tocan."/>
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                    <StackPanel x:Name="PageCursor" Visibility="Collapsed" Tag="Cursor y clics">
                    <CheckBox x:Name="ShowClicks" Content="Resaltar clics" Click="OnCursorEdit"/>
                    <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                    <Slider x:Name="RingSize" Minimum="24" Maximum="160" ValueChanged="OnCursorEdit"/>
                    <TextBlock Text="Duración"/>
                    <Slider x:Name="RingDuration" Minimum="0.2" Maximum="1.5" ValueChanged="OnCursorEdit"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Swatch}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnSwatch"/>
                        <Button Style="{StaticResource Swatch}" Background="#F59E0B" Tag="#F59E0B" Click="OnSwatch"/>
                        <Button Style="{StaticResource Swatch}" Background="#22C55E" Tag="#22C55E" Click="OnSwatch"/>
                        <Button Style="{StaticResource Swatch}" Background="#3B82F6" Tag="#3B82F6" Click="OnSwatch"/>
                        <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnSwatch"/>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageCamera" Visibility="Collapsed" Tag="Cámara">
                    <StackPanel x:Name="CamSection">
                        <CheckBox x:Name="CamVisible" Content="Mostrar cámara" Click="OnCamEdit"/>
                        <CheckBox x:Name="CamMirror" Content="Efecto espejo" Click="OnCamEdit" Margin="0,4,0,0"/>
                        <ComboBox x:Name="CamShape" Margin="0,6,0,0" SelectionChanged="OnCamEdit">
                            <ComboBoxItem Content="Círculo"/>
                            <ComboBoxItem Content="Bordes redondeados"/>
                        </ComboBox>
                        <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                        <Slider x:Name="CamSize" Minimum="0.1" Maximum="0.7" ValueChanged="OnCamEdit"/>
                        <WrapPanel>
                            <Button Content="↖" Tag="0.12,0.2" Click="OnCamPreset" Width="36" ToolTip="Superior izquierda"/>
                            <Button Content="↗" Tag="0.88,0.2" Click="OnCamPreset" Width="36" Margin="6,0,0,0" ToolTip="Superior derecha"/>
                            <Button Content="↙" Tag="0.12,0.8" Click="OnCamPreset" Width="36" Margin="6,0,0,0" ToolTip="Inferior izquierda"/>
                            <Button Content="↘" Tag="0.88,0.8" Click="OnCamPreset" Width="36" Margin="6,0,0,0" ToolTip="Inferior derecha"/>
                            <Button Content="Presentación" Tag="0.75,0.5,0.62" Click="OnCamPreset" Margin="6,0,0,0" ToolTip="Cámara grande a la derecha"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Arrastra la cámara en la vista previa para moverla."/>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageAudio" Visibility="Collapsed" Tag="Audio">
                    <StackPanel x:Name="MicSection">
                        <DockPanel>
                            <CheckBox x:Name="MicMute" Content="Silenciar" DockPanel.Dock="Right" Click="OnAudioEdit"/>
                            <TextBlock x:Name="MicLabel" Text="Micrófono"/>
                        </DockPanel>
                        <Slider x:Name="MicGain" Minimum="-24" Maximum="12" ValueChanged="OnAudioEdit" ToolTip="Ganancia (dB)"/>
                        <TextBlock x:Name="MicSyncLabel" Style="{StaticResource Hint}"/>
                        <Slider x:Name="MicSync" Minimum="-1" Maximum="1" ValueChanged="OnAudioEdit" ToolTip="Sincronización manual (s)"/>
                    </StackPanel>
                    <StackPanel x:Name="SysSection">
                        <DockPanel>
                            <CheckBox x:Name="SysMute" Content="Silenciar" DockPanel.Dock="Right" Click="OnAudioEdit"/>
                            <TextBlock x:Name="SysLabel" Text="Audio del sistema"/>
                        </DockPanel>
                        <Slider x:Name="SysGain" Minimum="-24" Maximum="12" ValueChanged="OnAudioEdit" ToolTip="Ganancia (dB)"/>
                        <TextBlock x:Name="SysSyncLabel" Style="{StaticResource Hint}"/>
                        <Slider x:Name="SysSync" Minimum="-1" Maximum="1" ValueChanged="OnAudioEdit" ToolTip="Sincronización manual (s)"/>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageText" Visibility="Collapsed" Tag="Texto">
                    <WrapPanel>
                        <Button Content="Añadir texto" Click="OnAddText" ToolTip="Texto de 3 s en el cabezal"/>
                        <Button x:Name="DelTextBtn" Content="Quitar" Click="OnDeleteText" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <StackPanel x:Name="TextPanel" Margin="0,8,0,0">
                        <TextBox x:Name="TextContent" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" TextChanged="OnTextEdit"/>
                        <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                        <Slider x:Name="TextSize" Minimum="0.02" Maximum="0.2" ValueChanged="OnTextEdit"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnTextColor"/>
                            <Button Style="{StaticResource Swatch}" Background="#FACC15" Tag="#FACC15" Click="OnTextColor"/>
                            <Button Style="{StaticResource Swatch}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnTextColor"/>
                            <Button Style="{StaticResource Swatch}" Background="#22C55E" Tag="#22C55E" Click="OnTextColor"/>
                            <Button Style="{StaticResource Swatch}" Background="#111111" Tag="#111111" Click="OnTextColor"/>
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="TextBg" Content="Fondo" Click="OnTextEdit"/>
                            <CheckBox x:Name="TextBold" Content="Negrita" Click="OnTextEdit" Margin="12,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Inicio = cabezal" Click="OnTextStartHere"/>
                            <Button Content="Fin = cabezal" Click="OnTextEndHere" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Arrastra el texto en la vista previa para moverlo."/>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageSubs" Visibility="Collapsed" Tag="Subtítulos">
                    <WrapPanel>
                        <Button Content="Añadir" Click="OnAddCue" ToolTip="Subtítulo en el cabezal"/>
                        <Button x:Name="DelCueBtn" Content="Quitar" Click="OnDeleteCue" Margin="6,0,0,0"/>
                        <Button Content="Importar SRT…" Click="OnImportSrt" Margin="6,0,0,0" ToolTip="Tiempos del video exportado"/>
                        <Button Content="Exportar SRT…" Click="OnExportSrt" Margin="0,6,0,0" ToolTip="Tiempos ajustados a los cortes"/>
                    </WrapPanel>
                    <StackPanel x:Name="CuePanel" Margin="0,8,0,0">
                        <TextBox x:Name="CueContent" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" TextChanged="OnCueEdit"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Inicio = cabezal" Click="OnCueStartHere"/>
                            <Button Content="Fin = cabezal" Click="OnCueEndHere" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock x:Name="CueInfo" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                    <Slider x:Name="SubSize" Minimum="0.02" Maximum="0.1" ValueChanged="OnSubStyleEdit"/>
                    <TextBlock Text="Posición vertical"/>
                    <Slider x:Name="SubY" Minimum="0.05" Maximum="0.95" ValueChanged="OnSubStyleEdit"/>
                    <CheckBox x:Name="SubBg" Content="Fondo" Click="OnSubStyleEdit"/>
                    <CheckBox x:Name="SubBurn" Content="Incrustar en el video exportado" Click="OnSubStyleEdit" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="PageAnn" Visibility="Collapsed" Tag="Anotaciones">
                    <WrapPanel>
                        <Button Content="Flecha" Tag="Arrow" Click="OnAddAnn" Margin="0,0,6,6"/>
                        <Button Content="Rectángulo" Tag="Rectangle" Click="OnAddAnn" Margin="0,0,6,6"/>
                        <Button Content="Círculo" Tag="Ellipse" Click="OnAddAnn" Margin="0,0,6,6"/>
                        <Button Content="Resaltado" Tag="Highlight" Click="OnAddAnn" Margin="0,0,6,6"/>
                        <Button Content="Desenfoque" Tag="Blur" Click="OnAddAnn" Margin="0,0,6,6" ToolTip="Oculta datos privados"/>
                        <Button Content="Pixelado" Tag="Pixelate" Click="OnAddAnn" Margin="0,0,6,6" ToolTip="Oculta datos privados"/>
                    </WrapPanel>
                    <StackPanel x:Name="AnnPanel">
                        <TextBlock x:Name="AnnInfo" Style="{StaticResource Hint}"/>
                        <StackPanel x:Name="AnnStyle">
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource Swatch}" Background="#EF4444" Tag="#EF4444" Click="OnAnnColor"/>
                                <Button Style="{StaticResource Swatch}" Background="#FACC15" Tag="#FACC15" Click="OnAnnColor"/>
                                <Button Style="{StaticResource Swatch}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnAnnColor"/>
                                <Button Style="{StaticResource Swatch}" Background="#22C55E" Tag="#22C55E" Click="OnAnnColor"/>
                                <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnAnnColor"/>
                            </StackPanel>
                            <TextBlock Text="Grosor" Margin="0,6,0,0"/>
                            <Slider x:Name="AnnThickness" Minimum="2" Maximum="24" ValueChanged="OnAnnThickness"/>
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Inicio = cabezal" Click="OnAnnStartHere"/>
                            <Button Content="Fin = cabezal" Click="OnAnnEndHere" Margin="6,0,0,0"/>
                            <Button x:Name="DelAnnBtn" Content="Quitar" Click="OnDeleteAnn" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Arrastra la forma en la vista previa para moverla y sus puntos para cambiar el tamaño."/>
                    </StackPanel>
                    <StackPanel x:Name="PageKeys" Visibility="Collapsed" Tag="Atajos de teclado">
                    <StackPanel x:Name="KeysSection">
                        <CheckBox x:Name="KeysVisible" Content="Mostrar atajos" Click="OnKeysEdit"/>
                        <ComboBox x:Name="KeysLook" Margin="0,6,0,0" SelectionChanged="OnKeysEdit">
                            <ComboBoxItem Content="Cápsula"/>
                            <ComboBoxItem Content="Minimalista"/>
                        </ComboBox>
                        <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                        <Slider x:Name="KeysSize" Minimum="0.02" Maximum="0.1" ValueChanged="OnKeysEdit"/>
                        <TextBlock Text="Duración en pantalla"/>
                        <Slider x:Name="KeysDuration" Minimum="0.5" Maximum="3" ValueChanged="OnKeysEdit"/>
                        <TextBlock x:Name="KeysInfo" Style="{StaticResource Hint}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Arrastra el atajo en la vista previa para moverlo."/>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="PageFormat" Visibility="Collapsed" Tag="Formato y encuadre">
                    <StackPanel x:Name="FormatSection">
                    <ComboBox x:Name="FormatBox" SelectionChanged="OnFormatEdit">
                        <ComboBoxItem Content="Original"/>
                        <ComboBoxItem Content="16:9 horizontal (YouTube, cursos)"/>
                        <ComboBoxItem Content="9:16 vertical (TikTok, Reels, Shorts)"/>
                        <ComboBoxItem Content="1:1 cuadrado"/>
                        <ComboBoxItem Content="4:3"/>
                    </ComboBox>
                    <TextBlock x:Name="FramingHint" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Arrastra el video en la vista previa para encuadrar. Los zooms (también de 1.0×) mueven el encuadre en el tiempo."/>

                    </StackPanel>                    </StackPanel>
                    <StackPanel x:Name="PageExport" Visibility="Collapsed" Tag="Exportación">
                    <ComboBox x:Name="PresetBox" SelectionChanged="OnPreset" ToolTip="Rellena los ajustes de abajo; puedes cambiarlos después">
                        <ComboBoxItem Content="Preset…" IsEnabled="False"/>
                        <ComboBoxItem Content="Rápido"/>
                        <ComboBoxItem Content="Equilibrado"/>
                        <ComboBoxItem Content="Alta calidad"/>
                        <ComboBoxItem Content="Máxima calidad"/>
                        <ComboBoxItem Content="YouTube 4K"/>
                        <ComboBoxItem Content="Redes sociales (9:16, 1080×1920)"/>
                    </ComboBox>
                    <ComboBox x:Name="ExportFormatBox" Margin="0,6,0,0" SelectionChanged="OnExportEdit">
                        <ComboBoxItem Content="MP4 · H.264 (compatible)"/>
                        <ComboBoxItem Content="MP4 · HEVC/H.265 (más pequeño)"/>
                        <ComboBoxItem Content="MKV · H.264"/>
                        <ComboBoxItem Content="WAV · solo audio"/>
                        <ComboBoxItem Content="PNG · fotograma del cabezal"/>
                        <ComboBoxItem Content="MP4 · AV1 (el más pequeño; reproductores recientes)"/>
                    </ComboBox>
                    <ComboBox x:Name="ExportHeight" Margin="0,6,0,0" SelectionChanged="OnExportEdit">
                        <ComboBoxItem Content="Resolución nativa" Tag="0"/>
                        <ComboBoxItem Content="2160p (4K)" Tag="2160"/>
                        <ComboBoxItem Content="1440p" Tag="1440"/>
                        <ComboBoxItem Content="1080p (Full HD)" Tag="1080"/>
                        <ComboBoxItem Content="720p" Tag="720"/>
                    </ComboBox>
                    <ComboBox x:Name="ExportQualityBox" Margin="0,6,0,0" SelectionChanged="OnExportEdit">
                        <ComboBoxItem Content="Rápida"/>
                        <ComboBoxItem Content="Equilibrada"/>
                        <ComboBoxItem Content="Alta calidad"/>
                        <ComboBoxItem Content="Máxima calidad"/>
                    </ComboBox>
                    <ComboBox x:Name="ExportFpsBox" Margin="0,6,0,0" SelectionChanged="OnExportEdit">
                        <ComboBoxItem Content="FPS de la grabación" Tag="0"/>
                        <ComboBoxItem Content="24 FPS" Tag="24"/>
                        <ComboBoxItem Content="30 FPS" Tag="30"/>
                        <ComboBoxItem Content="60 FPS" Tag="60"/>
                    </ComboBox>
                    <TextBlock x:Name="ExportInfo" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Preview: same layer order as the exporter -->
            <Border Grid.Column="2" Background="#0D0D12" Margin="0,0,12,0" CornerRadius="10" ClipToBounds="True">
                <Viewbox Margin="12" Stretch="Uniform">
                    <Grid x:Name="Stage" ClipToBounds="True" Background="Black" MouseLeftButtonDown="OnStageClick" MouseMove="OnStageMove" MouseLeftButtonUp="OnStageUp">
                        <Canvas x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top" MouseMove="OnAnnMove" MouseLeftButtonUp="OnAnnUp">
                            <Canvas.RenderTransform><MatrixTransform x:Name="ZoomTransform"/></Canvas.RenderTransform>
                            <MediaElement x:Name="ScreenMedia" LoadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Fill" IsMuted="True"/>
                            <Canvas x:Name="AnnLayer"/>
                            <Canvas x:Name="RingLayer" IsHitTestVisible="False"/>
                            <Canvas x:Name="HandleLayer"/>
                        </Canvas>
                        <Border x:Name="CamFrame" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeAll"
                                MouseLeftButtonDown="OnCamDown" MouseMove="OnCamMove" MouseLeftButtonUp="OnCamUp">
                            <MediaElement x:Name="CamMedia" LoadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Fill"
                                          IsMuted="True" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Border>
                        <Canvas x:Name="TextLayer"/>
                        <Canvas x:Name="KeyLayer"/>
                    </Grid>
                </Viewbox>
            </Border>
            <MediaElement x:Name="MicMedia" Grid.Column="2" LoadedBehavior="Manual" Width="0" Height="0"/>
            <MediaElement x:Name="SysMedia" Grid.Column="2" LoadedBehavior="Manual" Width="0" Height="0"/>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Transport + timeline -->
        <DockPanel Grid.Row="3" Margin="12,0,12,12">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoBtn" Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="OnUndo" ToolTip="Deshacer (Ctrl+Z)" AutomationProperties.Name="Deshacer"/>
                    <Button x:Name="RedoBtn" Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="OnRedo" ToolTip="Rehacer (Ctrl+Y)" AutomationProperties.Name="Rehacer" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C6;" Click="OnSplit" ToolTip="Dividir en el cabezal (S)" AutomationProperties.Name="Dividir"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnDeleteSegment" ToolTip="Eliminar el tramo bajo el cabezal (Supr)" AutomationProperties.Name="Eliminar tramo"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="OnMoveClipEarlier" ToolTip="Mover el clip bajo el cabezal un puesto antes (Ctrl+←)" AutomationProperties.Name="Mover clip antes"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Click="OnMoveClipLater" ToolTip="Mover el clip bajo el cabezal un puesto después (Ctrl+→)" AutomationProperties.Name="Mover clip después"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayBtn" Content="▶" Width="44" Height="32" Click="OnPlay" ToolTip="Reproducir / pausar (Espacio)"/>
                    <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="12,0,0,0" FontFamily="Cascadia Mono, Consolas"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE946;" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.ToolTip><TextBlock x:Name="RowsHint" TextWrapping="Wrap" MaxWidth="420"/></TextBlock.ToolTip>
                    </TextBlock>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Click="OnZoomOutTimeline" ToolTip="Alejar línea de tiempo (Ctrl+−, Ctrl+rueda)" AutomationProperties.Name="Alejar línea de tiempo"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="OnZoomInTimeline" ToolTip="Acercar línea de tiempo (Ctrl++, Ctrl+rueda)" AutomationProperties.Name="Acercar línea de tiempo"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" Click="OnFitTimeline" ToolTip="Ver toda la grabación (Ctrl+0)" AutomationProperties.Name="Ajustar línea de tiempo" Margin="0"/>
                </StackPanel>
            </Grid>
            <ScrollBar x:Name="TimelineScroll" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0" Scroll="OnTimelineScroll" Visibility="Collapsed"/>
            <Border CornerRadius="6" Background="#14141B" ClipToBounds="True">
                <Canvas x:Name="Timeline" Background="Transparent" SizeChanged="OnTimelineResize"
                        MouseLeftButtonDown="OnTimelineDown" MouseMove="OnTimelineMove" MouseLeftButtonUp="OnTimelineUp" MouseWheel="OnTimelineWheel"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
