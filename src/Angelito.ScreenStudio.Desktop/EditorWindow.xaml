<Window x:Class="Angelito.ScreenStudio.Desktop.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Angelito Screen Studio Pro — Editor" Width="1360" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" PreviewKeyDown="OnKey">
    <Window.Resources>
        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="280" MinHeight="200"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Margin="12,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Abrir…" Click="OnOpen" ToolTip="Abrir proyecto (Ctrl+O)"/>
                <Button Content="Guardar" Click="OnSave" Margin="6,0,0,0" ToolTip="Guardar (Ctrl+S) — también se guarda automáticamente"/>
                <Button x:Name="UndoBtn" Content="↶" Click="OnUndo" Margin="16,0,0,0" ToolTip="Deshacer (Ctrl+Z)" Width="38"/>
                <Button x:Name="RedoBtn" Content="↷" Click="OnRedo" Margin="6,0,0,0" ToolTip="Rehacer (Ctrl+Y)" Width="38"/>
                <Button Content="Dividir" Click="OnSplit" Margin="16,0,0,0" ToolTip="Dividir en el cabezal (S)"/>
                <Button Content="Eliminar tramo" Click="OnDeleteSegment" Margin="6,0,0,0" ToolTip="Eliminar el tramo bajo el cabezal (Supr)"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ProgressBar x:Name="ExportProgress" Width="160" Height="6" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center"/>
                <Button x:Name="CancelExportBtn" Content="Cancelar" Click="OnCancelExport" Margin="8,0,0,0" Visibility="Collapsed"/>
                <Button x:Name="ExportBtn" Content="Exportar MP4" Style="{StaticResource AccentButton}" Click="OnExport" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ProjectName" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Preview: same layer order as the exporter -->
            <Border Background="#0D0D12" Margin="12,0,0,0" CornerRadius="8" ClipToBounds="True">
                <Viewbox Margin="12" Stretch="Uniform">
                    <Grid x:Name="Stage" ClipToBounds="True" Background="Black" MouseLeftButtonDown="OnStageClick">
                        <Canvas x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top" MouseMove="OnAnnMove" MouseLeftButtonUp="OnAnnUp">
                            <Canvas.RenderTransform><MatrixTransform x:Name="ZoomTransform"/></Canvas.RenderTransform>
                            <MediaElement x:Name="ScreenMedia" LoadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Fill" IsMuted="True"/>
                            <Canvas x:Name="AnnLayer"/>
                            <Canvas x:Name="RingLayer" IsHitTestVisible="False"/>
                            <Canvas x:Name="HandleLayer"/>
                        </Canvas>
                        <Border x:Name="CamFrame" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeAll"
                                MouseLeftButtonDown="OnCamDown" MouseMove="OnCamMove" MouseLeftButtonUp="OnCamUp">
                            <MediaElement x:Name="CamMedia" LoadedBehavior="Manual" ScrubbingEnabled="True" Stretch="UniformToFill"
                                          IsMuted="True" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <Canvas x:Name="TextLayer"/>
                    </Grid>
                </Viewbox>
            </Border>
            <MediaElement x:Name="MicMedia" LoadedBehavior="Manual" Width="0" Height="0"/>
            <MediaElement x:Name="SysMedia" LoadedBehavior="Manual" Width="0" Height="0"/>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Inspector -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="4,0,16,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Zoom" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="Auto-zoom" Click="OnAutoZoom" ToolTip="Regenera propuestas a partir de los clics (reemplaza los zooms actuales)"/>
                        <Button Content="Añadir" Click="OnAddZoom" Margin="6,0,0,0" ToolTip="Nuevo zoom de 3 s en el cabezal"/>
                        <Button x:Name="DelZoomBtn" Content="Quitar" Click="OnDeleteZoom" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <StackPanel x:Name="ZoomPanel" Margin="0,8,0,0">
                        <TextBlock x:Name="ZoomInfo" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Intensidad" Margin="0,6,0,0"/>
                        <Slider x:Name="ZoomScale" Minimum="1.1" Maximum="4" ValueChanged="OnZoomEdit"/>
                        <TextBlock Text="Suavizado (entrada/salida)"/>
                        <Slider x:Name="ZoomRamp" Minimum="0.1" Maximum="2" ValueChanged="OnZoomEdit"/>
                        <WrapPanel>
                            <Button Content="Inicio = cabezal" Click="OnZoomStartHere"/>
                            <Button Content="Fin = cabezal" Click="OnZoomEndHere" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Haz clic en la vista previa para centrar el zoom seleccionado."/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="Texto"/>
                    <WrapPanel>
                        <Button Content="Añadir texto" Click="OnAddText" ToolTip="Texto de 3 s en el cabezal"/>
                        <Button x:Name="DelTextBtn" Content="Quitar" Click="OnDeleteText" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <StackPanel x:Name="TextPanel" Margin="0,8,0,0">
                        <TextBox x:Name="TextContent" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" TextChanged="OnTextEdit"/>
                        <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                        <Slider x:Name="TextSize" Minimum="0.02" Maximum="0.2" ValueChanged="OnTextEdit"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnTextColor"/>
                            <Button Style="{StaticResource Swatch}" Background="#FACC15" Tag="#FACC15" Click="OnTextColor"/>
                            <Button Style="{StaticResource Swatch}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnTextColor"/>
                            <Button Style="{StaticResource Swatch}" Background="#22C55E" Tag="#22C55E" Click="OnTextColor"/>
                            <Button Style="{StaticResource Swatch}" Background="#111111" Tag="#111111" Click="OnTextColor"/>
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="TextBg" Content="Fondo" Click="OnTextEdit"/>
                            <CheckBox x:Name="TextBold" Content="Negrita" Click="OnTextEdit" Margin="12,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Inicio = cabezal" Click="OnTextStartHere"/>
                            <Button Content="Fin = cabezal" Click="OnTextEndHere" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Arrastra el texto en la vista previa para moverlo."/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="Subtítulos"/>
                    <WrapPanel>
                        <Button Content="Añadir" Click="OnAddCue" ToolTip="Subtítulo en el cabezal"/>
                        <Button x:Name="DelCueBtn" Content="Quitar" Click="OnDeleteCue" Margin="6,0,0,0"/>
                        <Button Content="Importar SRT…" Click="OnImportSrt" Margin="6,0,0,0" ToolTip="Tiempos del video exportado"/>
                        <Button Content="Exportar SRT…" Click="OnExportSrt" Margin="0,6,0,0" ToolTip="Tiempos ajustados a los cortes"/>
                    </WrapPanel>
                    <StackPanel x:Name="CuePanel" Margin="0,8,0,0">
                        <TextBox x:Name="CueContent" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" TextChanged="OnCueEdit"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Inicio = cabezal" Click="OnCueStartHere"/>
                            <Button Content="Fin = cabezal" Click="OnCueEndHere" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock x:Name="CueInfo" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                    <Slider x:Name="SubSize" Minimum="0.02" Maximum="0.1" ValueChanged="OnSubStyleEdit"/>
                    <TextBlock Text="Posición vertical"/>
                    <Slider x:Name="SubY" Minimum="0.05" Maximum="0.95" ValueChanged="OnSubStyleEdit"/>
                    <CheckBox x:Name="SubBg" Content="Fondo" Click="OnSubStyleEdit"/>
                    <CheckBox x:Name="SubBurn" Content="Incrustar en el video exportado" Click="OnSubStyleEdit" Margin="0,4,0,0"/>

                    <TextBlock Style="{StaticResource Section}" Text="Anotaciones"/>
                    <WrapPanel>
                        <Button Content="Flecha" Tag="Arrow" Click="OnAddAnn" Margin="0,0,6,6"/>
                        <Button Content="Rectángulo" Tag="Rectangle" Click="OnAddAnn" Margin="0,0,6,6"/>
                        <Button Content="Círculo" Tag="Ellipse" Click="OnAddAnn" Margin="0,0,6,6"/>
                        <Button Content="Resaltado" Tag="Highlight" Click="OnAddAnn" Margin="0,0,6,6"/>
                        <Button Content="Desenfoque" Tag="Blur" Click="OnAddAnn" Margin="0,0,6,6" ToolTip="Oculta datos privados"/>
                        <Button Content="Pixelado" Tag="Pixelate" Click="OnAddAnn" Margin="0,0,6,6" ToolTip="Oculta datos privados"/>
                    </WrapPanel>
                    <StackPanel x:Name="AnnPanel">
                        <TextBlock x:Name="AnnInfo" Style="{StaticResource Hint}"/>
                        <StackPanel x:Name="AnnStyle">
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource Swatch}" Background="#EF4444" Tag="#EF4444" Click="OnAnnColor"/>
                                <Button Style="{StaticResource Swatch}" Background="#FACC15" Tag="#FACC15" Click="OnAnnColor"/>
                                <Button Style="{StaticResource Swatch}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnAnnColor"/>
                                <Button Style="{StaticResource Swatch}" Background="#22C55E" Tag="#22C55E" Click="OnAnnColor"/>
                                <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnAnnColor"/>
                            </StackPanel>
                            <TextBlock Text="Grosor" Margin="0,6,0,0"/>
                            <Slider x:Name="AnnThickness" Minimum="2" Maximum="24" ValueChanged="OnAnnThickness"/>
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Inicio = cabezal" Click="OnAnnStartHere"/>
                            <Button Content="Fin = cabezal" Click="OnAnnEndHere" Margin="6,0,0,0"/>
                            <Button x:Name="DelAnnBtn" Content="Quitar" Click="OnDeleteAnn" Margin="6,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Arrastra la forma en la vista previa para moverla y sus puntos para cambiar el tamaño."/>

                    <TextBlock Style="{StaticResource Section}" Text="Cursor"/>
                    <CheckBox x:Name="ShowClicks" Content="Resaltar clics" Click="OnCursorEdit"/>
                    <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                    <Slider x:Name="RingSize" Minimum="24" Maximum="160" ValueChanged="OnCursorEdit"/>
                    <TextBlock Text="Duración"/>
                    <Slider x:Name="RingDuration" Minimum="0.2" Maximum="1.5" ValueChanged="OnCursorEdit"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Swatch}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnSwatch"/>
                        <Button Style="{StaticResource Swatch}" Background="#F59E0B" Tag="#F59E0B" Click="OnSwatch"/>
                        <Button Style="{StaticResource Swatch}" Background="#22C55E" Tag="#22C55E" Click="OnSwatch"/>
                        <Button Style="{StaticResource Swatch}" Background="#3B82F6" Tag="#3B82F6" Click="OnSwatch"/>
                        <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnSwatch"/>
                    </StackPanel>

                    <StackPanel x:Name="CamSection">
                        <TextBlock Style="{StaticResource Section}" Text="Cámara"/>
                        <CheckBox x:Name="CamVisible" Content="Mostrar cámara" Click="OnCamEdit"/>
                        <CheckBox x:Name="CamMirror" Content="Efecto espejo" Click="OnCamEdit" Margin="0,4,0,0"/>
                        <ComboBox x:Name="CamShape" Margin="0,6,0,0" SelectionChanged="OnCamEdit">
                            <ComboBoxItem Content="Círculo"/>
                            <ComboBoxItem Content="Bordes redondeados"/>
                        </ComboBox>
                        <TextBlock Text="Tamaño" Margin="0,6,0,0"/>
                        <Slider x:Name="CamSize" Minimum="0.1" Maximum="0.7" ValueChanged="OnCamEdit"/>
                        <WrapPanel>
                            <Button Content="↖" Tag="0.12,0.2" Click="OnCamPreset" Width="36" ToolTip="Superior izquierda"/>
                            <Button Content="↗" Tag="0.88,0.2" Click="OnCamPreset" Width="36" Margin="6,0,0,0" ToolTip="Superior derecha"/>
                            <Button Content="↙" Tag="0.12,0.8" Click="OnCamPreset" Width="36" Margin="6,0,0,0" ToolTip="Inferior izquierda"/>
                            <Button Content="↘" Tag="0.88,0.8" Click="OnCamPreset" Width="36" Margin="6,0,0,0" ToolTip="Inferior derecha"/>
                            <Button Content="Presentación" Tag="0.75,0.5,0.62" Click="OnCamPreset" Margin="6,0,0,0" ToolTip="Cámara grande a la derecha"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Arrastra la cámara en la vista previa para moverla."/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="Audio"/>
                    <StackPanel x:Name="MicSection">
                        <DockPanel>
                            <CheckBox x:Name="MicMute" Content="Silenciar" DockPanel.Dock="Right" Click="OnAudioEdit"/>
                            <TextBlock x:Name="MicLabel" Text="Micrófono"/>
                        </DockPanel>
                        <Slider x:Name="MicGain" Minimum="-24" Maximum="12" ValueChanged="OnAudioEdit" ToolTip="Ganancia (dB)"/>
                        <TextBlock x:Name="MicSyncLabel" Style="{StaticResource Hint}"/>
                        <Slider x:Name="MicSync" Minimum="-1" Maximum="1" ValueChanged="OnAudioEdit" ToolTip="Sincronización manual (s)"/>
                    </StackPanel>
                    <StackPanel x:Name="SysSection">
                        <DockPanel>
                            <CheckBox x:Name="SysMute" Content="Silenciar" DockPanel.Dock="Right" Click="OnAudioEdit"/>
                            <TextBlock x:Name="SysLabel" Text="Audio del sistema"/>
                        </DockPanel>
                        <Slider x:Name="SysGain" Minimum="-24" Maximum="12" ValueChanged="OnAudioEdit" ToolTip="Ganancia (dB)"/>
                        <TextBlock x:Name="SysSyncLabel" Style="{StaticResource Hint}"/>
                        <Slider x:Name="SysSync" Minimum="-1" Maximum="1" ValueChanged="OnAudioEdit" ToolTip="Sincronización manual (s)"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="Exportación"/>
                    <ComboBox x:Name="ExportHeight" SelectionChanged="OnExportEdit">
                        <ComboBoxItem Content="Resolución original" Tag="0"/>
                        <ComboBoxItem Content="2160p (4K)" Tag="2160"/>
                        <ComboBoxItem Content="1440p" Tag="1440"/>
                        <ComboBoxItem Content="1080p (Full HD)" Tag="1080"/>
                        <ComboBoxItem Content="720p" Tag="720"/>
                    </ComboBox>
                    <ComboBox x:Name="ExportQualityBox" Margin="0,6,0,0" SelectionChanged="OnExportEdit">
                        <ComboBoxItem Content="Rápida"/>
                        <ComboBoxItem Content="Equilibrada"/>
                        <ComboBoxItem Content="Alta calidad"/>
                    </ComboBox>
                    <TextBlock x:Name="ExportInfo" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Transport + timeline -->
        <DockPanel Grid.Row="3" Margin="12,0,12,12">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="PlayBtn" Content="▶" Width="44" Click="OnPlay" ToolTip="Reproducir / pausar (Espacio)"/>
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="12,0" FontFamily="Cascadia Mono, Consolas"/>
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="Filas: clips · zoom · texto · subtítulos · anotaciones · audio · clics    Espacio: reproducir · S: dividir · Supr: eliminar tramo · ←/→: fotograma · Ctrl+Z/Y"/>
            </DockPanel>
            <Border CornerRadius="6" Background="#14141B" ClipToBounds="True">
                <Canvas x:Name="Timeline" Background="Transparent" SizeChanged="OnTimelineResize"
                        MouseLeftButtonDown="OnTimelineDown" MouseMove="OnTimelineMove" MouseLeftButtonUp="OnTimelineUp"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
