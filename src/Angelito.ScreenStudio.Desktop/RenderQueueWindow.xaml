<Window x:Class="Angelito.ScreenStudio.Desktop.RenderQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cola de exportación — Angelito Screen Studio Pro" Width="560" Height="420" MinWidth="420" MinHeight="240">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button Content="Quitar terminados" Click="OnClearFinished" DockPanel.Dock="Right"/>
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Text="Los trabajos se exportan uno a la vez. Puedes seguir editando: cada trabajo usa el proyecto tal como estaba al añadirlo."/>
        </DockPanel>
        <ListBox x:Name="List" HorizontalContentAlignment="Stretch" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="4,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="Mostrar" Click="OnReveal" Margin="8,0,0,0" ToolTip="Abrir la carpeta">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Cancelar" Click="OnCancel" Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}"/>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Error}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
