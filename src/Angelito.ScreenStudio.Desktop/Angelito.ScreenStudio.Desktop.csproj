<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Compiled against the Windows 11 SDK (Windows.Graphics.Capture incl. borderless capture); still runs on Windows 10 2004+. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AngelitoScreenStudio</AssemblyName>
    <Product>Angelito Screen Studio Pro</Product>
    <Company>Angelito Systems S.A.C.</Company>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Copyright>© Angelito Systems S.A.C.</Copyright>
    <!-- WPF0001: Fluent ThemeMode is flagged experimental; used for native light/dark support. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Angelito.ScreenStudio.Core\Angelito.ScreenStudio.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
