<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AngelitoScreenStudio</AssemblyName>
    <Product>Angelito Screen Studio Pro</Product>
    <Company>Angelito Systems S.A.C.</Company>
    <Version>0.1.0</Version>
    <!-- WPF0001: Fluent ThemeMode is flagged experimental; used for native light/dark support. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Angelito.ScreenStudio.Core\Angelito.ScreenStudio.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
